# Zaza Draft local Firebase configuration
# Production source of truth for app users, auth, roles, entitlements, and user_profiles:
#   zaza-draft-app
# Legacy licensing project:
#   zaza-id-and-licences
# Do not point local Draft app auth/admin state at the legacy project.

NEXT_PUBLIC_FIREBASE_API_KEY=<zaza-draft-app-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zaza-draft-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zaza-draft-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zaza-draft-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<zaza-draft-app-messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<zaza-draft-app-web-app-id>
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=<optional-measurement-id>

NEXT_PUBLIC_APP_URL=http://localhost:3000
FIREBASE_PROJECT_ID=zaza-draft-app
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\<you>\Secrets\zaza-draft\firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=zaza-draft-app.firebasestorage.app

ZAZA_ID_BASE_URL=https://zaza-id-and-licences.vercel.app
ZAZA_ID_ENTITLEMENTS_ENABLED=0
FORCE_PRO_USER_IDS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-20250514
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_SPEECH_TO_TEXT_API_KEY=
