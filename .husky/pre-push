#!/usr/bin/env sh
set -e

# Ensure we’re in the repo root (hooks sometimes execute from .git/)
repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo"

# Prefer pnpm; fall back to npx vitest if pnpm isn't on PATH in Git Bash
if command -v pnpm >/dev/null 2>&1; then
  pnpm run test:fast
else
  npx -y vitest vitest --run --reporter=dot -c vitest.fast.config.ts
fi