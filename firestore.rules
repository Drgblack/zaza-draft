rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Classes: only owner can write; others can read if member (future)
    match /classes/{classId} {
      allow read: if request.auth != null; // adjust as needed
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // Students subcollection
      match /students/{studentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.ownerId;
      }

      // Context docs
      match /context/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/classes/$(classId)).data.ownerId;
      }
    }

    // Snippets: owner only
    match /snippets/{snippetId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
