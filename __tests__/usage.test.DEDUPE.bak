let getUserProfile:any, incrementSnippetUsage:any, canGenerateSnippet:any;
beforeEach(async () => {
  __MEM.clear();
  vi.clearAllMocks();
  const usage = await import("@/lib/firestore/usage");
  getUserProfile = usage.getUserProfile;
