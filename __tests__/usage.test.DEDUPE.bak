import { vi, beforeEach } from "vitest";

// Mock client db BEFORE importing the module under test
const mockDB = { __mock: true };
vi.mock("@/lib/firebase/client", () => ({ db: mockDB }));

// In-memory Firestore + modular API shims (collection/doc chaining)
const __MEM = new Map<string, any>();
const pathOf = (segs: string[]) => segs.join("/");

type Col = { __segs: string[] };

const collection = (db: any, ...segs: string[]): Col => {
  if (db !== mockDB) throw new Error("collection() with unexpected db");
  return { __segs: segs };
};

const doc = (colOrDb: any, ...segs: string[]) => {
  if (colOrDb && Array.isArray(colOrDb.__segs)) {
    // doc(collection(db, 'x'), 'y') => 'x/y'
    return { __path: pathOf([...colOrDb.__segs, ...segs]) };
  }
  if (colOrDb !== mockDB) throw new Error("doc() with unexpected db");
  return { __path: pathOf(segs) };
};

const getDoc = async (ref: any) => {
  const data = __MEM.get(ref.__path);
  return { exists: () => data != null, data: () => data };
};

const setDoc = async (ref: any, data: any) => {
  __MEM.set(ref.__path, { ...(__MEM.get(ref.__path) || {}), ...data });
};

const updateDoc = async (ref: any, patch: Record<string, any>) => {
  const cur = __MEM.get(ref.__path) || {};
  const next: any = { ...cur };
  for (const [k, v] of Object.entries(patch)) {
    if (v && typeof v === "object" && "__inc" in v) next[k] = (cur[k] ?? 0) + (v as any).__inc;
    else next[k] = v;
  }
  __MEM.set(ref.__path, next);
};

const increment = (n: number) => ({ __inc: n });
const serverTimestamp = () => new Date();

vi.mock("firebase/firestore", () => ({
  collection, doc, getDoc, setDoc, updateDoc, increment, serverTimestamp,
}));

