        "dev:3011": "next dev -p 3011",
        "dev:3012": "next dev -p 3012",
        "start": "next start"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "next": "^16.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "volta": {
        "node": "22.18.0"
    },
    "devDependencies": {
        "@types/node": "^24.9.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "autoprefixer": "^10.4.21",
        "baseline-browser-mapping": "^2.9.11",
        "postcss": "^8.5.6",
        "tailwindcss": "3",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.0.0"
