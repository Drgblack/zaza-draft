{
    "name": "zaza-draft",
    "private": true,
    "version": "0.1.1",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "build": "next build",
        "test": "npm run test:smoke",
        "test:smoke": "node scripts/smoke-draft.mjs",
        "typecheck": "tsc -v >NUL 2>&1 || exit 0",
