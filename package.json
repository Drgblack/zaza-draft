{
    "name":  "zaza-draft",
    "private":  true,
    "version":  "0.1.2",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "lint":  "eslint .",
                    "build":  "pnpm run test:ci \u0026\u0026 next build",
                    "test":  "vitest",
                    "test:watch":  "vitest --watch",
                    "test:coverage":  "vitest run --coverage",
                    "test:smoke":  "node scripts/smoke-draft.mjs",
                    "test:all":  "npm run test \u0026\u0026 npm run test:smoke",
                    "typecheck":  "tsc -v \u003eNUL 2\u003e\u00261 || exit 0",
                    "dev":  "next dev",
                    "dev:3011":  "next dev -p 3011",
                    "dev:3012":  "next dev -p 3012",
                    "start":  "next start",
                    "release:check":  "node scripts/release-check.js",
                    "test:ci":  "vitest --run --reporter=dot",
                    "prepare":  "husky"
                },
    "dependencies":  {
                         "@hookform/resolvers":  "^5.2.2",
                         "@stripe/stripe-js":  "^8.2.0",
                         "ajv":  "^8.17.1",
                         "ajv-formats":  "^3.0.1",
                         "firebase":  "^12.4.0",
                         "firebase-admin":  "^13.5.0",
                         "next":  "^16.0.0",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "react-hook-form":  "^7.65.0",
                         "react-hot-toast":  "^2.6.0",
                         "stripe":  "^19.2.0",
                         "zod":  "^4.1.12"
                     },
    "volta":  {
                  "node":  "22.18.0"
              },
    "devDependencies":  {
                            "@playwright/test":  "^1.56.1",
                            "@testing-library/jest-dom":  "^6.9.1",
                            "@testing-library/react":  "^16.3.0",
                            "@types/jest":  "^30.0.0",
                            "@types/jsdom":  "^27.0.0",
                            "@types/node":  "^24.9.1",
                            "@types/react":  "^19.2.2",
                            "@types/react-dom":  "^19.2.2",
                            "@vitejs/plugin-react":  "^5.1.0",
                            "@vitest/coverage-v8":  "^4.0.5",
                            "autoprefixer":  "^10.4.21",
                            "firebase-functions-test":  "^3.4.1",
                            "husky":  "9",
                            "jest":  "^30.2.0",
                            "jest-environment-jsdom":  "^30.2.0",
                            "jsdom":  "^27.1.0",
                            "playwright":  "^1.56.1",
                            "postcss":  "^8.5.6",
                            "tailwindcss":  "^4.1.16",
                            "ts-jest":  "^29.4.5",
                            "typescript":  "^5.9.3",
                            "vite-tsconfig-paths":  "^5.1.4",
                            "vitest":  "^4.0.5"
                        },
    "packageManager":  "pnpm@10.0.0"
}